#!/bin/bash
# jobsearch: the old name of ./oyster, kept so links made by `jobsearch install` still work.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
exec "$(cd -P "$(dirname "$src")" && pwd)/oyster" "$@"
